{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.tauri/**)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/.env)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(pnpm release:*)",
      "Bash(pnpm run release:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Verificando política de segurança"
          }
        ]
      }
    ]
  }
}
