"require "net/http"
require "uri"

uri = URI("https://api.test/users")
http = Net::HTTP.new(uri.host, uri.port)
http.use_ssl = uri.scheme == "https"

request = Net::HTTPGenericRequest.new("POST", true, true, uri.request_uri)
request.add_field("Content-Type", "application/json")
request.add_field("Authorization", "Bearer {{token}}")
request.body = "{\\n  \\"name\\": \\"O'Brien\\",\\n  \\"active\\": true,\\n  \\"tags\\": null\\n}"

response = http.request(request)
puts response.body"
`;

exports[`generateSnippet > generates ruby for a multipart POST 1`] = `
"require "net/http"
require "uri"

uri = URI("https://api.test/upload")
http = Net::HTTP.new(uri.host, uri.port)
http.use_ssl = uri.scheme == "https"

request = Net::HTTPGenericRequest.new("POST", true, true, uri.request_uri)
request.set_form([
  ["title", "Report"],
  ["file", File.open("files/report.pdf")],
], "multipart/form-data")

response = http.request(request)
puts response.body"
`;

exports[`generateSnippet > generates rust for a JSON POST 1`] = `
"// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"] }
use reqwest::blocking::Client;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let response = Client::new()
        .request(reqwest::Method::POST, "https://api.test/users")
        .header("Content-Type", "application/json")
        .header("Authorization", "Bearer {{token}}")
        .body(r#"{
  "name": "O'Brien",
  "active": true,
  "tags": null
}"#)
        .send()?;

    println!("{}", response.text()?);
    Ok(())
}"
`;

exports[`generateSnippet > generates rust for a multipart POST 1`] = `
"// Cargo.toml: reqwest = { version = "0.12", features = ["blocking", "multipart"] }
use reqwest::blocking::Client;
use reqwest::blocking::multipart::Form;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let form = Form::new()
        .text("title", "Report")
        .file("file", "files/report.pdf")?;

    let response = Client::new()
        .request(reqwest::Method::POST, "https://api.test/upload")
        .multipart(form)
        .send()?;

    println!("{}", response.text()?);
    Ok(())
}"
`;

exports[`generateSnippet > generates swift for a JSON POST 1`] = `
"import Foundation

var request = URLRequest(url: URL(string: "https://api.test/users")!)
request.httpMethod = "POST"
request.addValue("application/json", forHTTPHeaderField: "Content-Type")
request.addValue("Bearer {{token}}", forHTTPHeaderField: "Authorization")
request.httpBody = Data("{\\n  \\"name\\": \\"O'Brien\\",\\n  \\"active\\": true,\\n  \\"tags\\": null\\n}".utf8)

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))"
`;

exports[`generateSnippet > generates swift for a multipart POST 1`] = `
"import Foundation

var request = URLRequest(url: URL(string: "https://api.test/upload")!)
request.httpMethod = "POST"

let boundary = "Boundary-\\(UUID().uuidString)"
request.setValue("multipart/form-data; boundary=\\(boundary)", forHTTPHeaderField: "Content-Type")
var body = Data()
body.append(Data("--\\(boundary)\\r\\nContent-Disposition: form-data; name=\\"title\\"\\r\\n\\r\\nReport\\r\\n".utf8))
let file1 = URL(fileURLWithPath: "files/report.pdf")
body.append(Data("--\\(boundary)\\r\\nContent-Disposition: form-data; name=\\"file\\"; filename=\\"\\(file1.lastPathComponent)\\"\\r\\n\\r\\n".utf8))
body.append(try Data(contentsOf: file1))
body.append(Data("\\r\\n".utf8))
body.append(Data("--\\(boundary)--\\r\\n".utf8))
request.httpBody = body

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))"
`;

