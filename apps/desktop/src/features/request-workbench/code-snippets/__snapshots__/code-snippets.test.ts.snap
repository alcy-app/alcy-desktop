exports[`generateSnippet > generates kotlin for a JSON POST 1`] = `
"import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody

val client = OkHttpClient()

val body = "{\\n  \\"name\\": \\"O'Brien\\",\\n  \\"active\\": true,\\n  \\"tags\\": null\\n}".toRequestBody("application/json".toMediaType())

val request = Request.Builder()
    .url("https://api.test/users")
    .method("POST", body)
    .addHeader("Authorization", "Bearer {{token}}")
    .build()

client.newCall(request).execute().use { response ->
    println(response.body?.string())
}"
`;

exports[`generateSnippet > generates kotlin for a multipart POST 1`] = `
"import java.io.File
import okhttp3.MultipartBody
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.asRequestBody

val client = OkHttpClient()

val body = MultipartBody.Builder()
    .setType(MultipartBody.FORM)
    .addFormDataPart("title", "Report")
    .addFormDataPart("file", File("files/report.pdf").name, File("files/report.pdf").asRequestBody())
    .build()

val request = Request.Builder()
    .url("https://api.test/upload")
    .method("POST", body)
    .build()

client.newCall(request).execute().use { response ->
    println(response.body?.string())
}"
`;

